<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#111318">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NavWidget"
        android:textSize="28sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginTop="32dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ESP32 navigation bridge"
        android:textSize="14sp"
        android:textColor="#888888"
        android:layout_marginBottom="40dp"/>

    <!-- Step 1 -->
    <Button
        android:id="@+id/btnAccessibility"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Enable Accessibility (required)"
        android:backgroundTint="#FF6B00"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:layout_marginBottom="16dp"/>

    <!-- Step 2 -->
    <Button
        android:id="@+id/btnScan"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Scan for NavWidget ESP32"
        android:backgroundTint="#0055FF"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:layout_marginBottom="32dp"/>

    <!-- Status -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap scan to find your ESP32"
        android:textSize="14sp"
        android:textColor="#AAAAAA"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <!-- Nav preview -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LIVE NAV DATA"
        android:textSize="11sp"
        android:textColor="#555555"
        android:letterSpacing="0.15"/>

    <TextView
        android:id="@+id/tvNavPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="—"
        android:textSize="13sp"
        android:textColor="#00DDAA"
        android:fontFamily="monospace"
        android:padding="12dp"
        android:background="#1A1F2A"
        android:layout_marginTop="6dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Instructions:\n1. Tap 'Enable Accessibility' → find NavWidget → turn ON\n2. Keep Google Maps open and start navigation\n3. Tap Scan — app finds your ESP32 automatically\n4. Done — display updates live"
        android:textSize="13sp"
        android:textColor="#666666"
        android:lineSpacingExtra="4dp"/>

</LinearLayout>
